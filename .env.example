PORT=3000
NODE_ENV=development

# Clash of Clans API (Opción 1 recomendada: Proxy comunitario de RoyaleAPI)
# En https://developer.clashofclans.com autoriza la IP estática: 45.79.218.79
COC_API_KEY=your_supercell_api_key_here
COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1
# Respaldo automático por si usás URL directa en COC_API_BASE_URL y cambia tu IP
COC_API_PROXY_BASE_URL=https://cocproxy.royaleapi.dev/v1
COC_PROXY_API_KEY=
COC_API_TIMEOUT_MS=12000

# Supabase Configuration (servicio administrado en la nube)
SUPABASE_URL=https://your-project.supabase.co
# Clave pública / anon (inicia con sb_publishable_ o eyJhbGciOi...)
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# Clave secreta service_role (para funciones admin, worker de notificaciones y auto-confirmación)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API (Moderación automática de foros e imágenes y Chatbot Táctico IA)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.8-flash
